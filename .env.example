# Copy to .env for local development. In production set these in your host's
# environment settings instead of a file.

# development | production. Production refuses to start without SECRET_KEY and
# DATABASE_URL, turns on secure cookies/HSTS, and hides the USSD simulator.
APP_ENV=development

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# PostgreSQL in production, e.g. postgresql://user:password@host:5432/tujali?sslmode=require
# Leave unset in development to use a local SQLite file (instance/tujali.db).
# DATABASE_URL=

# USSD service code shown to patients and in SMS messages
USSD_CODE=*384*4040#

# SMS: "console" records messages in the SMS log without sending them.
# "africastalking" sends them (use AT_USERNAME=sandbox while testing).
SMS_BACKEND=console
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# ALERT_SMS_LIMIT=5000            # max SMS per health alert broadcast

# First administrator, used by `flask --app main create-admin`
ADMIN_NAME=Tujali Admin
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional
# LOG_LEVEL=INFO
# ENABLE_USSD_SIMULATOR=false     # /simulator demo phone
# BEHIND_PROXY=true               # trust X-Forwarded-* from one reverse proxy
# SESSION_COOKIE_SECURE=true      # requires HTTPS
# USSD_ALLOWED_IPS=               # comma-separated gateway IPs allowed to call /ussd
