# Copy to .env for local development. In production set these in your host's
# environment settings instead of a file.

# development | production. Production refuses to start without SECRET_KEY and
# DATABASE_URL, turns on secure cookies/HSTS, and disables self-registration
# and the USSD simulator by default.
APP_ENV=development

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# PostgreSQL in production, e.g. postgresql://user:password@host:5432/tujali?sslmode=require
# Leave unset in development to use a local SQLite file (instance/tujali.db).
# DATABASE_URL=

# First admin account, used by `flask --app main create-admin`
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Optional settings
# LOG_LEVEL=INFO
# ALLOW_REGISTRATION=false        # public provider sign-up page
# ENABLE_USSD_SIMULATOR=false     # /ussd_simulator.html test page
# BEHIND_PROXY=true               # trust X-Forwarded-* from one reverse proxy
# SESSION_COOKIE_SECURE=true      # requires HTTPS
# USSD_ALLOWED_IPS=               # comma-separated gateway IPs allowed to call /ussd

# AI content: the offline mock is used unless USE_MOCK_AI=false
USE_MOCK_AI=true
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
